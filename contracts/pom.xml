<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ch.swisstopo.monteis</groupId>
    <artifactId>parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>contracts</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- The generated Fulcrum @HttpExchange interface refers to ResponseEntity, the HTTP service
         annotations and MultipartFile. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Fetches the third-party Fulcrum REST API spec at the SHA pinned in the parent pom.
           Deliberately not vendored into src/main/resources: Renovate bumps the SHA but cannot
           rewrite the 400+ KB document, so a checked-in copy would drift out of sync with the
           pin next to it. Downloaded to target/classes instead, which both feeds the generator
           below and ships the exact pinned contract in the jar for FulcrumSpecTest to assert
           against. -->
      <plugin>
        <groupId>com.googlecode.maven-download-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>fetch-fulcrum-spec</id>
            <goals>
              <goal>wget</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <url>${fulcrum.spec.url}</url>
              <outputDirectory>${project.build.outputDirectory}/fulcrum</outputDirectory>
              <outputFileName>rest-api.json</outputFileName>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-monteis-models</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi.yml</inputSpec>

              <generatorName>spring</generatorName>

              <generateApis>false</generateApis>
              <generateApiTests>false</generateApiTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelTests>false</generateModelTests>
              <generateSupportingFiles>false</generateSupportingFiles>

              <modelPackage>ch.swisstopo.monteis.contracts</modelPackage>

              <configOptions>
                <useRecords>true</useRecords>
              </configOptions>
            </configuration>
          </execution>

          <!-- Models of the Fulcrum API. Models only, like the execution above: the spec types
               no response body for /v2/query (its 200 is an empty EmptySuccessResponse), so the
               query row DTOs stay hand-written and only the remaining resources - records,
               forms, attachments, changesets - plus the BadRequestResponse error envelope come
               from here. openApiNullable is off so the generated code needs no JsonNullable,
               whose jackson-databind-nullable is built against Jackson 2 while the application
               runs on Jackson 3. -->
          <execution>
            <id>generate-fulcrum-models</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.build.outputDirectory}/fulcrum/rest-api.json</inputSpec>

              <generatorName>spring</generatorName>

              <!-- Unlike the MonTEIS execution above this one also generates the API, as a
                   Spring @HttpExchange interface: endpoint paths, query parameter names and
                   their documented defaults then come from the spec instead of being retyped in
                   the client. The spec declares no tags, so every operation lands in a single
                   DefaultApi. -->
              <generateApis>true</generateApis>
              <library>spring-http-interface</library>
              <generateApiTests>false</generateApiTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelTests>false</generateModelTests>
              <generateModelDocumentation>false</generateModelDocumentation>
              <generateSupportingFiles>false</generateSupportingFiles>

              <apiPackage>ch.swisstopo.monteis.contracts.fulcrum.api</apiPackage>
              <modelPackage>ch.swisstopo.monteis.contracts.fulcrum</modelPackage>
              <output>${project.build.directory}/generated-sources/openapi-fulcrum</output>

              <configOptions>
                <useRecords>true</useRecords>
                <openApiNullable>false</openApiNullable>
                <useOneOfInterfaces>false</useOneOfInterfaces>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
