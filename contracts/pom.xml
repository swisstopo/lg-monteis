<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ch.swisstopo.monteis</groupId>
    <artifactId>parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>contracts</artifactId>

  <properties>
    <download-maven-plugin.version>1.10.0</download-maven-plugin.version>

    <!-- Fulcrum REST API contract (MON-142). The spec is published only on the v2 branch of
         github.com/fulcrumapp/api, a repository that carries neither tags nor releases, so it is
         pinned to a commit SHA and kept current by Renovate: the customManager in renovate.json
         tracks that branch head via the git-refs datasource and raises a digest bump here. This
         value is the only thing recorded about the upstream document: the "Fulcrum Spec In Sync"
         check in pr-gate fetches the spec at this commit and compares it against the copy
         committed in this module, so no separate hash has to be kept in step with it. Most
         commits on that branch leave the spec untouched, so the check stays green and the PR
         automerges; a commit that does change it turns the check red until a developer runs
         .github/scripts/sync-fulcrum-spec-to-pin.sh on the branch and pushes the result.
         Keep this a SHA - resolving "v2" at build time would make the build unreproducible and
         leave Renovate nothing to bump. -->
    <fulcrum.spec.ref>0e36397a6cc292645283587ec62d4d808f667b44</fulcrum.spec.ref>

    <!-- The Fulcrum spec is committed rather than downloaded during the build: it is a
         third-party document in a repository we do not control, and no build should fail because
         GitHub is unreachable or rate-limiting. Being a normal resource it is also copied into
         the jar, which is where FulcrumSpecTest reads it from. Refreshing it is the explicit,
         network-using step in .github/scripts/sync-fulcrum-spec-to-pin.sh. -->
    <fulcrum.spec.file>${project.basedir}/src/main/resources/fulcrum/rest-api.json</fulcrum.spec.file>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- The generated Fulcrum @HttpExchange interface refers to ResponseEntity, the HTTP service
         annotations and MultipartFile. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Fetching the document at ${fulcrum.spec.ref} belongs to the module that owns both the
             pin and the committed copy. Managed rather than bound to a phase: every build reads
             the committed file, and the fetch happens only in
             .github/scripts/sync-fulcrum-spec-to-pin.sh. -->
        <plugin>
          <groupId>com.googlecode.maven-download-plugin</groupId>
          <artifactId>download-maven-plugin</artifactId>
          <version>${download-maven-plugin.version}</version>
          <configuration>
            <!-- Cached per URL, and the URL carries the pinned SHA, so the spec is fetched once
                 per bump and offline builds keep working afterwards. -->
            <skipCache>false</skipCache>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-monteis-models</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi.yml</inputSpec>

              <generatorName>spring</generatorName>

              <generateApis>false</generateApis>
              <generateApiTests>false</generateApiTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelTests>false</generateModelTests>
              <generateSupportingFiles>false</generateSupportingFiles>

              <modelPackage>ch.swisstopo.monteis.contracts</modelPackage>

              <configOptions>
                <useRecords>true</useRecords>
              </configOptions>
            </configuration>
          </execution>

          <!-- Models of the Fulcrum API. Models only, like the execution above: the spec types
               no response body for /v2/query (its 200 is an empty EmptySuccessResponse), so the
               query row DTOs stay hand-written and only the remaining resources - records,
               forms, attachments, changesets - plus the BadRequestResponse error envelope come
               from here. openApiNullable is off so the generated code needs no JsonNullable,
               whose jackson-databind-nullable is built against Jackson 2 while the application
               runs on Jackson 3. -->
          <execution>
            <id>generate-fulcrum-models</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${fulcrum.spec.file}</inputSpec>

              <generatorName>spring</generatorName>

              <!-- Unlike the MonTEIS execution above this one also generates the API, as a
                   Spring @HttpExchange interface: endpoint paths, query parameter names and
                   their documented defaults then come from the spec instead of being retyped in
                   the client. The spec declares no tags, so every operation lands in a single
                   DefaultApi. -->
              <generateApis>true</generateApis>
              <library>spring-http-interface</library>
              <generateApiTests>false</generateApiTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelTests>false</generateModelTests>
              <generateModelDocumentation>false</generateModelDocumentation>
              <generateSupportingFiles>false</generateSupportingFiles>

              <apiPackage>ch.swisstopo.monteis.contracts.fulcrum.api</apiPackage>
              <modelPackage>ch.swisstopo.monteis.contracts.fulcrum</modelPackage>
              <output>${project.build.directory}/generated-sources/openapi-fulcrum</output>

              <configOptions>
                <useRecords>true</useRecords>
                <openApiNullable>false</openApiNullable>
                <useOneOfInterfaces>false</useOneOfInterfaces>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
