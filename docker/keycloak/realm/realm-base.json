{
  "realm": "monteis",
  "enabled": true,
  "displayName": "MONTEIS",
  "loginTheme": "keycloak",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "adminPermissionsEnabled": true,
  "roles": {
    "realm": [
      { "name": "user", "description": "Standard MONTEIS user" },
      { "name": "admin", "description": "MONTEIS administrator" }
    ],
    "client": {
      "monteis-spa": [
        {
          "name": "monteis-client:experiment:read",
          "description": "Read access to the experiments listed in the caller's read_experiment_ids claim. Granted via an '/Experiments/<experiment>/read' or '/read + write' group - never assign this directly to a user.",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "monteis-client:experiment:write",
          "description": "Write access to the experiments listed in the caller's write_experiment_ids claim. Granted via an '/Experiments/<experiment>/read + write' group - never assign this directly to a user.",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "monteis-client:experiment:write:all",
          "description": "Read + write access to all experiments, bypassing per-experiment scoping (write:all implies all-experiment read). Not granted by default; add it to a dedicated group for non-admins, never assign it directly to a user.",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "monteis-client:documents:read",
          "description": "Open and download documents in the document directory. Granted via the 'Experiments' group (inherited by every experiment subgroup) or the 'Monteis Admin' group - never assign this directly to a user.",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "monteis-client:admin",
          "description": "Admin functions, including sensors; implies read + write access to all experiments. Granted via the 'Monteis Admin' group - never assign this directly to a user.",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "clientScopes": [
    {
      "name": "monteis-backend-audience",
      "description": "Adds the monteis-backend audience to access tokens",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "monteis-backend-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "monteis-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "monteis-oidc-basic",
      "description": "Base OIDC identity claims (sub, preferred_username). This realm is imported with an explicit clientScopes list, which suppresses Keycloak's built-in scopes, so these mappers are defined here.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "monteis-roles",
      "description": "Adds the user's monteis-spa client roles (and only those - the mapper is filtered to client monteis-spa) to the monteis_access.roles claim of the access token.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "monteis-spa-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "monteis-spa",
            "claim.name": "monteis_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "monteis-user-directory",
      "description": "Adds the user's realm-management client roles to resource_access.realm-management.roles. With fine grained admin permissions the Admin API reads them from the token, without this claim core gets a 403 when it looks up PIs with the caller's token.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "realm-management-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "realm-management",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "monteis-experiment-access",
      "description": "Adds read_experiment_ids / write_experiment_ids to access tokens, aggregated from the caller's groups. write implies read: write_experiment_ids is mapped into both claims, so a write group only sets write_experiment_ids.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "read-experiment-ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "read_experiment_ids",
            "claim.name": "read_experiment_ids",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "write-experiment-ids-as-read",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "write_experiment_ids",
            "claim.name": "read_experiment_ids",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "write-experiment-ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "write_experiment_ids",
            "claim.name": "write_experiment_ids",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "monteis-spa",
      "name": "MONTEIS SPA (Angular)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+", "login_theme": "monteis" },
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["monteis-oidc-basic", "monteis-backend-audience", "monteis-roles", "monteis-experiment-access", "monteis-user-directory"]
    },
    {
      "clientId": "monteis-backend",
      "name": "MONTEIS Core Backend (resource server)",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "admin-permissions",
      "description": "Fine grained admin permissions (v2). core asks the admin API with the caller's token, so every experiment user may view groups and their members, i.e. the PIs and their contact data. Keycloak creates this client itself, only the policies below are imported.",
      "authorizationServicesEnabled": true,
      "authorizationSettings": {
        "decisionStrategy": "UNANIMOUS",
        "policies": [
          {
            "name": "experiment-users",
            "description": "Everyone who reads experiments in MONTEIS, per experiment or all of them.",
            "type": "role",
            "logic": "POSITIVE",
            "config": {
              "roles": "[{\"id\":\"monteis-spa/monteis-client:experiment:read\",\"required\":false},{\"id\":\"monteis-spa/monteis-client:experiment:write:all\",\"required\":false}]"
            }
          },
          {
            "name": "experiment-users-view-groups",
            "description": "View every group and its members, which the owners of an experiment and the owner candidates are read from (MON-177).",
            "type": "scope",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "defaultResourceType": "Groups",
              "resources": "[\"Groups\"]",
              "scopes": "[\"view\",\"view-members\"]",
              "applyPolicies": "[\"experiment-users\"]"
            }
          }
        ]
      }
    }
  ],
  "groups": [
    {
      "name": "Monteis Admin",
      "path": "/Monteis Admin",
      "attributes": {
        "description": [
          "Full administrators: admin functions (which imply read + write access to every experiment) and document access. Members get monteis-client:admin and monteis-client:documents:read."
        ]
      },
      "clientRoles": {
        "monteis-spa": ["monteis-client:admin", "monteis-client:documents:read"],
        "realm-management": ["view-users", "query-users", "query-groups"]
      }
    },
    {
      "name": "Experiments",
      "path": "/Experiments",
      "attributes": {
        "description": [
          "Per-experiment groups: <experiment>/read and <experiment>/read + write. Every member inherits documents:read from here. Keep roles and attributes off <experiment> itself - both subgroups inherit them. read + write gets both roles and ids."
        ]
      },
      "clientRoles": {
        "monteis-spa": ["monteis-client:documents:read"],
        "realm-management": ["query-users", "query-groups"]
      }
    }
  ],
  "users": [],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  }
}
