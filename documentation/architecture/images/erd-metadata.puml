@startuml
!theme plain
hide circle
skinparam linetype ortho

' Massiv mehr Platz erzwingen, um Überlappungen zu verhindern
skinparam nodesep 100
skinparam ranksep 150

' Styling für die normalen PostgreSQL Tabellen
skinparam entity {
    BackgroundColor #F8F9FA
    BorderColor #343A40
}

' ==========================================
' LEGENDE (wird elegant in die Ecke gerendert)
' ==========================================
legend top left
  |= Icon / Symbol |= Bedeutung |
  | <color:#D32F2F><&key></color> | Primary Key (PK) |
  | <color:#1976D2><&link-intact></color> | Foreign Key (FK) |
  | <color:#F57C00><&star></color> | Unique Constraint |
  | (Kreis) | Not Null (Mandatory / Zwingend) |
  | (Quadrat) | Nullable (Optional) |
endlegend

title MONTEIS - Entity-Relationship Diagram

' ==========================================
' GLOBALE AUDIT-SPALTEN (Als Floating Note)
' ==========================================
note as AuditNote
  **Globale Audit-Spalten (Base Entity)**
  //Diese Spalten sind implizit in JEDER Tabelle//
  //vorhanden und werden hier zur Übersichtlichkeit//
  //nicht einzeln eingezeichnet://
  ----
  * created_at : TIMESTAMP
  * <color:#1976D2><&link-intact></color> created_by : UUID
  * updated_at : TIMESTAMP
  * <color:#1976D2><&link-intact></color> updated_by : UUID
  * deleted_at : TIMESTAMP
  * <color:#1976D2><&link-intact></color> deleted_by : UUID
  * version : INTEGER
  ----
  //Alle Primary Keys der Metadaten-DB sind UUIDv7//
  //(anwendungsseitig generiert, siehe ADR "UUID v7//
  //als einheitlicher Primärschlüsseltyp"). Ausnahme://
  //flyway_schema_history (von Flyway verwaltet).//
end note


' ==========================================
' ENTITIES: Organisation & Users
' ==========================================
entity "Organisations" as org {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * name : VARCHAR(255)
  - description : VARCHAR(4096)
}

entity "Users" as users {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * name : VARCHAR(255)
  * <color:#F57C00><&star></color> email : VARCHAR(255)
  - <color:#F57C00><&star></color> handy_number : VARCHAR(50)
}

entity "Experiments" as exp {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * name : VARCHAR(255)
  - description : VARCHAR(4096)
  * <color:#F57C00><&star></color> exp_code : VARCHAR(255)
}

entity "Alerts" as alerts {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * template_email : VARCHAR(4096)
  * template_sms : VARCHAR(2048)
  * type : VARCHAR(50)
}

' ==========================================
' EXPLICIT JOIN TABLES
' ==========================================
entity "organisation_user" as j_org_user {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * <color:#1976D2><&link-intact></color> org_id : UUID
  * <color:#1976D2><&link-intact></color> user_id : UUID
}

entity "experiment_organisation" as j_exp_org {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * <color:#1976D2><&link-intact></color> exp_id : UUID
  * <color:#1976D2><&link-intact></color> org_id : UUID
}

entity "user_experiment" as j_user_exp {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * <color:#1976D2><&link-intact></color> user_id : UUID
  * <color:#1976D2><&link-intact></color> exp_id : UUID
}

entity "sensor_experiment" as j_sensor_exp {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * <color:#1976D2><&link-intact></color> sensor_id : UUID
  * <color:#1976D2><&link-intact></color> exp_id : UUID
  --
  //id ist eigenständiger PK (nicht composite),//
  //damit Sensor.main_experiment gezielt genau//
  //eine Zeile dieser m:n-Relation referenzieren kann.//
}

entity "alert_sensor" as j_alert_sensor {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * <color:#1976D2><&link-intact></color> alert_id : UUID
  * <color:#1976D2><&link-intact></color> sensor_id : UUID
}

entity "user_alert" as j_user_alert {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * <color:#1976D2><&link-intact></color> user_id : UUID
  * <color:#1976D2><&link-intact></color> alert_id : UUID
  * method : VARCHAR(50)
}

' ==========================================
' ENTITIES: Infrastructure & Spatial
' ==========================================
entity "Tunnels" as tunnels {
  * <color:#D32F2F><&key></color> id : UUID
}

entity "Shafts" as shafts {
  * <color:#D32F2F><&key></color> id : UUID
}

entity "Boreholes" as boreholes {
  * <color:#D32F2F><&key></color> id : UUID
}

' ==========================================
' ENTITIES: Sensor (Shared Metadata) & Sensor_Parameter
' ==========================================
entity "Sensor" as sensors {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * <color:#F57C00><&star></color> fulcrum_id : UUID
  * <color:#F57C00><&star></color> das_sensor_alias : VARCHAR(255)
  * das : DAS_ENUM
  * name : VARCHAR(255)
  * x : INTEGER
  * y : INTEGER
  * z : INTEGER
  * active : BOOLEAN
  - comment : VARCHAR(4096)
  * <color:#1976D2><&link-intact></color> main_experiment : UUID
  --
  //das_sensor_alias bildet den Sensor auf die eintreffenden//
  //DAS-Rohmessungen ab. das identifiziert das Erfassungssystem//
  //(z.B. SOLEXPERTS). main_experiment verweist auf genau eine//
  //Zeile von sensor_experiment (siehe dort).//
}

entity "Sensor_Parameter" as sensor_param {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * <color:#1976D2><&link-intact></color> sensor_id : UUID
  * name : VARCHAR(255)
  * <color:#F57C00><&star></color> das_parameter_alias : VARCHAR(255)
  * <color:#1976D2><&link-intact></color> type_id : UUID
  * unit : UNIT_ENUM
  * <color:#1976D2><&link-intact></color> formula_id : UUID
  * lower_alarm_limit : DOUBLE PRECISION
  * upper_alarm_limit : DOUBLE PRECISION
  * active : BOOLEAN
  - comment : VARCHAR(4096)
  --
  //Ein Sensor kann mehrere Parameter (Messgrössen) mit je//
  //eigener Formel/Grenzwerten besitzen. id wird 1:1 im//
  //Config-Objekt an die Pipeline/TimescaleDB durchgereicht//
  //und dient dort als FK statt einer textuellen sensor_code-//
  //Abbildung (siehe Kapitel "Datenbankschemata").//
}

entity "Formula" as formula {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * <color:#F57C00><&star></color> expression : TEXT
}

entity "Sensor_Type" as sensor_type {
  * <color:#D32F2F><&key></color> id : UUID
  --
  * <color:#F57C00><&star></color> name : VARCHAR(255)
  - comment : VARCHAR(255)
}

entity "Virtual_sensors" as virtual_sensors {
  * <color:#D32F2F><&key></color> id : UUID
  - TODO (nicht im MVP)
}

entity "Hole_Coordinates" as hole_coords {
  * <color:#D32F2F><&key></color> id : UUID
}

' ==========================================
' STANDALONE TABLES
' ==========================================
entity "Flyway_Schemahistory" as flyway {
  * <color:#D32F2F><&key></color> id : INTEGER
  --
  //Von Flyway selbst verwaltet - keine UUIDv7 (Ausnahme, siehe ADR).//
}

entity "IFC_Uploads" as ifc {
  * <color:#D32F2F><&key></color> id : UUID
}

entity "Data_Uploads" as data_up {
  * <color:#D32F2F><&key></color> id : UUID
}

' ==========================================
' TIMESCALEDB (Getrenntes System)
' ==========================================
package "TimeScaleDB" <<Database>> {
    entity "Sensor_Data" as ts_data #E3F2FD {
      * <color:#1976D2><&link-intact></color> sensor_parameter_id : UUID
      * timestamp : TIMESTAMPTZ
      --
      //Composite PK (timestamp, sensor_parameter_id) - siehe//
      //TimeScaleDB Schema. sensor_parameter_id wird der Pipeline//
      //via Kafka Config-Objekt mitgeteilt (kein DB-FK, separates//
      //System) und referenziert fachlich Sensor_Parameter.id.//
    }
}

' ==========================================
' BEZIEHUNGEN (Entzerrt mit verlängerten Linien und Richtungen)
' ==========================================

' --- Infrastruktur Hierarchie (Top-Down forciert) ---
tunnels "1 " -down- " m" shafts
shafts "1 " -down- " m" boreholes
boreholes "1 " -down- " m" sensors

' --- 1:1 Beziehungen (Seitwärts forciert) ---
tunnels "1 " -right- " 1" hole_coords
shafts "1 " -right- " 1" hole_coords
boreholes "1 " -right- " 1" hole_coords

' --- Sensor & Parameter ---
sensors "1 " -down- " m" sensor_param
sensor_type "1 " -right- " m" sensor_param : " type"
formula "1 " -right- " m" sensor_param : " formula"
sensor_type "1 " -down- " m" virtual_sensors

' --- Join Tables (Lange Linien zur Entzerrung) ---
org "1 " --- " m" j_org_user
users "1 " --- " m" j_org_user

exp "1 " --- " m" j_exp_org
org "1 " --- " m" j_exp_org

users "1 " --- " m" j_user_exp
exp "1 " --- " m" j_user_exp

sensors "1 " --- " m" j_sensor_exp
exp "1 " --- " m" j_sensor_exp
sensors "1 " -up- " 1" j_sensor_exp : " main_experiment"

alerts "1 " --- " m" j_alert_sensor
sensors "1 " --- " m" j_alert_sensor

users "1 " --- " m" j_user_alert
alerts "1 " --- " m" j_user_alert

' --- FDW Verbindung ---
sensor_param "1 " .down. " m" ts_data : " FDW Tunnel"

AuditNote -[hidden]down-> sensors
AuditNote -[hidden]right-> sensors

@enduml
