<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>ch.swisstopo.monteis</groupId>
  <artifactId>parent</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>contracts</module>
    <module>core</module>
    <module>pipeline</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <testcontainers.postgres.version>1.21.4</testcontainers.postgres.version>
    <testcontainers.kafka.version>1.21.4</testcontainers.kafka.version>
    <postgresql.version>42.7.13</postgresql.version>
    <springdoc.version>3.1.0</springdoc.version>
    <sonar.version>5.7.0.6970</sonar.version>
    <springdoc-plugin.version>1.5</springdoc-plugin.version>
    <spotless.version>3.10.2</spotless.version>
    <groovy-maven-plugin.version>2.1.1</groovy-maven-plugin.version>
    <openapi-generator-plugin.version>7.25.0</openapi-generator-plugin.version>
    <swagger-annotations.version>2.2.55</swagger-annotations.version>
    <jackson-databind-nullable.version>0.2.11</jackson-databind-nullable.version>
    <parsington.version>3.3.0</parsington.version>
    <maven-build-helper.version>3.6.1</maven-build-helper.version>
    <download-maven-plugin.version>1.10.0</download-maven-plugin.version>
    <javers.version>7.11.8</javers.version>
    <spring-boot-starter-aop.version>3.5.16</spring-boot-starter-aop.version>
    <org.mapstruct.version>1.6.3</org.mapstruct.version>
    <archunit-junit5.version>1.5.0</archunit-junit5.version>
    <jacoco.version>0.8.15</jacoco.version>
    <testcontainers-keycloak.version>4.3.1</testcontainers-keycloak.version>
    <aws-msk-iam-auth.version>2.3.8</aws-msk-iam-auth.version>

    <!-- Override the Spring Boot BOM's managed flyway.version so the test-scoped
         flyway-core + flyway-database-postgresql (Testcontainers validation) and the
         flyway-maven-plugin (jOOQ codegen) match the migration image runner (MON-87:
         docker/migration builds FROM flyway/flyway 12.11.0-alpine). Keeps validator ==
         runner so CI actually exercises the version that migrates cloud RDS/TimescaleDB. -->
    <flyway.version>13.5.0</flyway.version>

    <!-- Override the Spring Boot BOM's managed netty.version to pull the patched
         io.netty 4.2.16.Final. Fixes 5 HIGH DoS CVEs in netty-codec-* baked into
         the runtime image (CVE-2026-59901 compression bzip2 infinite loop;
         CVE-2026-55831/-55833/-56745 codec-http SPDY DoS; CVE-2026-56819 codec-http2
         HTTP/2 DATA-frame memory leak), caught by the pre-release image scan. These
         are source-dependency CVEs, so they are fixed here, never waived in
         .trivyignore. Drop this override once the Spring Boot BOM manages >= 4.2.16. -->
    <netty.version>4.2.16.Final</netty.version>

    <!-- Override the Spring Boot BOM's managed tomcat.version to pull the patched
         tomcat-embed-core 11.0.25. Fixes CVE-2026-65182 (security constraint bypass),
         CVE-2026-65905 (DIGEST auth replay bypass) and CVE-2026-68525 (FORM auth
         bypass) in tomcat-embed-core 11.0.24, caught by the Trivy scan. Spring Boot
         4.1.1 is currently the latest release and still manages the vulnerable 11.0.24.
         Drop this override once the Spring Boot BOM manages >= 11.0.25. -->
    <tomcat.version>11.0.25</tomcat.version>

    <jooq.codegen.skip>false</jooq.codegen.skip>

    <!-- Fulcrum REST API contract (MON-142). The spec is published only on the v2 branch of
         github.com/fulcrumapp/api, a repository that carries neither tags nor releases, so it is
         pinned to a commit SHA and kept current by Renovate: the customManager in renovate.json
         tracks that branch head via the git-refs datasource and raises a digest bump here. This
         value is the only thing recorded about the upstream document: the "Fulcrum Spec In Sync"
         check in pr-gate fetches the spec at this commit and compares it against the committed
         copy in contracts, so no separate hash has to be kept in step with it. Most commits on
         that branch leave the spec untouched, so the check stays green and the PR automerges; a
         commit that does change it turns the check red until a developer runs
         .github/scripts/sync-fulcrum-spec-to-pin.sh on the branch and pushes the result.
         Keep this a SHA - resolving "v2" at build time would make the build unreproducible and
         leave Renovate nothing to bump. -->
    <fulcrum.spec.ref>0e36397a6cc292645283587ec62d4d808f667b44</fulcrum.spec.ref>

  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>contracts</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-annotations</artifactId>
        <version>${swagger-annotations.version}</version>
      </dependency>

      <dependency>
        <groupId>org.openapitools</groupId>
        <artifactId>jackson-databind-nullable</artifactId>
        <version>${jackson-databind-nullable.version}</version>
      </dependency>

      <dependency>
        <groupId>org.scijava</groupId>
        <artifactId>parsington</artifactId>
        <version>${parsington.version}</version>
      </dependency>

      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>

      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>

      <dependency>
        <groupId>org.javers</groupId>
        <artifactId>javers-persistence-sql</artifactId>
        <version>${javers.version}</version>
      </dependency>

      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-aop</artifactId>
        <version>${spring-boot-starter-aop.version}</version>
      </dependency>

      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>postgresql</artifactId>
        <version>${testcontainers.postgres.version}</version>
      </dependency>

      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>kafka</artifactId>
        <version>${testcontainers.kafka.version}</version>
      </dependency>

      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${org.mapstruct.version}</version>
      </dependency>

      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct-processor</artifactId>
        <version>${org.mapstruct.version}</version>
        <scope>provided</scope>
      </dependency>

      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit-junit5.version}</version>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>com.github.dasniko</groupId>
        <artifactId>testcontainers-keycloak</artifactId>
        <version>${testcontainers-keycloak.version}</version>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>software.amazon.msk</groupId>
        <artifactId>aws-msk-iam-auth</artifactId>
        <version>${aws-msk-iam-auth.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar.version}</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <image>
              <builder>paketobuildpacks/builder-jammy-java-tiny</builder>
              <env>
                <BP_JVM_VERSION>${java.version}</BP_JVM_VERSION>
              </env>
            </image>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <systemPropertyVariables>
              <monteis.repo.root>${maven.multiModuleProjectDirectory}</monteis.repo.root>
            </systemPropertyVariables>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <systemPropertyVariables>
              <monteis.repo.root>${maven.multiModuleProjectDirectory}</monteis.repo.root>
            </systemPropertyVariables>
            <argLine>@{argLine}</argLine>
          </configuration>
        </plugin>

        <!-- MAPSTRUCT -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <annotationProcessorPaths>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${org.mapstruct.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>

        <!--        FORMATTING -->
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <formats>
              <format>
                <includes>
                  <include>.gitattributes</include>
                  <include>.gitignore</include>
                </includes>
                <trimTrailingWhitespace/>
                <endWithNewline/>
                <indent>
                  <tabs>true</tabs>
                  <spacesPerTab>4</spacesPerTab>
                </indent>
              </format>
            </formats>
            <java>
              <includes>
                <include>**/src/main/java/**/*.java</include>
                <include>**/src/test/java/**/*.java</include>
              </includes>
              <!-- openapi-generator and jOOQ write their output under target/ into a
                   .../src/main/java/... layout, which the includes above would otherwise match.
                   Build output is never formatted, and on a built tree spotless:check would fail
                   on files nobody can fix by hand. -->
              <excludes>
                <exclude>**/target/**/*.java</exclude>
              </excludes>
              <googleJavaFormat>
                <reflowLongStrings>true</reflowLongStrings>
                <formatJavadoc>false</formatJavadoc>
              </googleJavaFormat>
              <removeUnusedImports/>
            </java>
            <sql>
              <includes>
                <include>**/src/main/resources/**/*.sql</include>
              </includes>
            </sql>
            <pom>
              <includes>
                <include>**/pom.xml</include>
              </includes>
              <sortPom>
                <encoding>UTF-8</encoding>
                <keepBlankLines>true</keepBlankLines>
              </sortPom>
            </pom>
            <markdown>
              <includes>
                <include>**/*.md</include>
              </includes>
              <excludes>
                <exclude>webapp/**/*.md</exclude>
              </excludes>
              <flexmark/>
            </markdown>
          </configuration>
        </plugin>
        <!--        JOOQ CODE GEN incl. FLYWAY-->
        <plugin>
          <groupId>org.codehaus.gmaven</groupId>
          <artifactId>groovy-maven-plugin</artifactId>
          <version>${groovy-maven-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>org.testcontainers</groupId>
              <artifactId>postgresql</artifactId>
              <version>${testcontainers.postgres.version}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.springdoc</groupId>
          <artifactId>springdoc-openapi-maven-plugin</artifactId>
          <version>${springdoc-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.openapitools</groupId>
          <artifactId>openapi-generator-maven-plugin</artifactId>
          <version>${openapi-generator-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>com.googlecode.maven-download-plugin</groupId>
          <artifactId>download-maven-plugin</artifactId>
          <version>${download-maven-plugin.version}</version>
          <configuration>
            <!-- Cached per URL, and the URL carries the pinned SHA, so the spec is fetched once
                 per bump and offline builds keep working afterwards. -->
            <skipCache>false</skipCache>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.flywaydb</groupId>
          <artifactId>flyway-maven-plugin</artifactId>
          <version>${flyway.version}</version>
          <configuration>
            <skip>${jooq.codegen.skip}</skip>
            <user>user</user>
            <password>pwd</password>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>org.flywaydb</groupId>
              <artifactId>flyway-database-postgresql</artifactId>
              <version>${flyway.version}</version>
            </dependency>
          </dependencies>
        </plugin>

        <plugin>
          <groupId>org.jooq</groupId>
          <artifactId>jooq-codegen-maven</artifactId>
          <version>${jooq.version}</version>
          <configuration>
            <skip>${jooq.codegen.skip}</skip>
            <generator>
              <database>
                <name>org.jooq.meta.postgres.PostgresDatabase</name>
                <inputSchema>public</inputSchema>
                <excludes>flyway_schema_history</excludes>
              </database>
              <target>
                <directory>target/generated-sources/jooq</directory>
              </target>
            </generator>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${maven-build-helper.version}</version>
          <executions>
            <execution>
              <id>add-jooq-source</id>
              <goals>
                <goal>add-source</goal>
              </goals>
              <phase>generate-sources</phase>
              <configuration>
                <sources>
                  <source>target/generated-sources/jooq</source>
                </sources>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <configuration>
            <formats>
              <format>XML</format>
            </formats>
          </configuration>
          <executions>
            <execution>
              <id>pre-unit-tests</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>post-unit-test</id>
              <goals>
                <goal>report</goal>
              </goals>
              <phase>test</phase>
            </execution>
            <execution>
              <id>pre-integration-tests</id>
              <goals>
                <goal>prepare-agent-integration</goal>
              </goals>
              <phase>pre-integration-test</phase>
            </execution>
            <execution>
              <id>post-integration-tests</id>
              <goals>
                <goal>report-integration</goal>
              </goals>
              <phase>post-integration-test</phase>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>properties-maven-plugin</artifactId>
        <version>1.3.0</version>
        <executions>
          <execution>
            <goals>
              <goal>read-project-properties</goal>
            </goals>
            <phase>compile</phase>
            <inherited>false</inherited>
            <configuration>
              <files>
                <file>sonar-project.properties</file>
              </files>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
