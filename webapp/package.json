{
  "name": "webapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:e2e": "ng serve --configuration=e2e",
    "build": "ng build",
    "lint": "ng lint",
    "watch": "ng build --watch --configuration development",
    "test": " pnpm vitest --browser.headless=true",
    "generate-api": "openapi-generator-cli generate",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "format:write": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "e2e:headed": "playwright test --ui",
    "e2e:headless": "playwright test",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@giro3d/giro3d": "^2.0.7",
    "@ngx-translate/core": "^18.1.0",
    "@scion/components": "^22.7.0",
    "@scion/microfrontend-platform": "^3.0.0",
    "@scion/toolkit": "^2.5.0",
    "@scion/workbench": "22.0.0-beta.2",
    "@scion/workbench-client": "1.0.0-beta.43",
    "ag-grid-angular": "^36.3.0",
    "ag-grid-community": "^36.3.0",
    "angular-eslint": "^22.8.0",
    "angular-oauth2-oidc": "^22.0.2",
    "chart.js": "^4.6.2",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.4.0",
    "rxjs": "~7.8.2",
    "three": "^0.187.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.8",
    "@angular-eslint/builder": "22.8.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.43.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitest/browser-playwright": "^5.1.1",
    "angular-eslint": "22.8.0",
    "corepack": "^0.36.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "^5.1.1"
  }
