{
  "name": "webapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:e2e": "ng serve --configuration=e2e",
    "build": "ng build",
    "lint": "ng lint",
    "watch": "ng build --watch --configuration development",
    "test": " pnpm vitest --browser.headless=true",
    "generate-api": "openapi-generator-cli generate",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "format:write": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "e2e:headed": "playwright test --headed",
    "e2e:headless": "playwright test",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@ngx-translate/core": "^18.0.0",
    "@scion/components": "^22.2.0",
    "@scion/microfrontend-platform": "^2.1.0",
    "@scion/toolkit": "^2.1.0",
    "@scion/workbench": "22.0.0-beta.1",
    "@scion/workbench-client": "1.0.0-beta.42",
    "ag-grid-angular": "^36.1.0",
    "ag-grid-community": "^36.1.0",
    "angular-eslint": "^22.1.0",
    "angular-oauth2-oidc": "^22.0.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.4.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@playwright/test": "^1.62.1",
    "@vitest/browser-playwright": "^4.1.11",
    "angular-eslint": "22.1.0",
    "corepack": "^0.35.0",
    "eslint": "^10.8.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.1.11"
  }
}
